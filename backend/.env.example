DATABASE_URL=sqlite:///./kiosco.db
FRONTEND_ORIGIN=http://localhost:5173
# Opcional: clave de la API de Anthropic para que KioscoBot responda con IA.
# Vacía = el bot responde solo con reglas. Nunca subas una clave real a git.
BOT_API_KEY=
BOT_MODEL=claude-haiku-5-5
# Administrador: se crea al arrancar si no existe (contraseña de 8 caracteres o más).
# Cambiar la contraseña acá no actualiza un admin que ya está en la base.
ADMIN_EMAIL=
ADMIN_PASSWORD=